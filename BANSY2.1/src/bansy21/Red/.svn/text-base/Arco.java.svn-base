package bansy21.Red;
import java.io.Serializable;

public class Arco implements Serializable
{
	public Node from;
	public Node to;
	public boolean directed=true;
	public Arco sig=null;
        public double weight=1;

	
	public Object[] getNodesInAVector()
	{
		Object[] v=new Object[2];
		v[0]=from.name;
		v[0]=to.name;		
		return v;
	}

}