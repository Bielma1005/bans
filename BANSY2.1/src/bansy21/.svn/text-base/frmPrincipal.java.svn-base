// ------------------------------------------------------------------------
/*revisa los datos para obtener los valores posibles de las variables */
	private void getValues()
	{
		int con1=0;
		Node temp=bPE.inicio;
		do
		{
			temp.values=new Vector();
			for(int i=0;i<bPE.casos.size();i++)
			{
                            Object ob= ((Object[])bPE.casos.elementAt(i))[con1];
                            boolean boll=util.miembro(ob,temp.values);
				if(!boll)
				{
					temp.values.addElement(((Object[])bPE.casos.elementAt(i))[con1]);
				}
			}
			if(temp.values.size()==1)
				temp.values.addElement("0");
			//System.out.println(""+temp.values.size());
			temp.table=util.getTable(temp);
			temp=temp.sig;
			con1++;
		}while(temp!=null);
	}
