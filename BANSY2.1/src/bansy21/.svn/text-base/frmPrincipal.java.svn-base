        {  NaiveInference nai=new NaiveInference();
           if(redF.redPanel.selectedN!=null) nai.varDep=redF.redPanel.selectedN;
           else nai.varDep=bPE.varDep;
           System.out.println(""+nai.getProbability(redF.redPanel.red));
        }
        else
          JOptionPane.showMessageDialog(this,"Seleccione una red.","Red",JOptionPane.INFORMATION_MESSAGE);
	}
        
        // --------------------------------------------------------------------------	
// Métodos para Organizar Ventanas
// --------------------------------------------------------------------------	
	public void VenOrgMenuCascada()
      { int ancho, alto, delta=30;
        JInternalFrame f;
        JInternalFrame[] aframe = desktop.getAllFrames();
        ancho = (int)desktop.getWidth()  - delta * (aframe.length - 1);
        alto  = (int)desktop.getHeight() - delta * (aframe.length - 1);
        for(int k=0; k < aframe.length; k++)
        { f = aframe[k]; 
          try{ f.setIcon( false ); }
          catch( java.beans.PropertyVetoException e ) {};
          try{ f.setMaximum( false ); }
          catch( java.beans.PropertyVetoException e ) {}; 
          f.setSize( ancho, alto ); f.setLocation( k * delta, k * delta );   
        }
      }
// --------------------------------------------------------------------------	
	public void VenOrgMenuRejilla()
      {
        int ancho, alto, Nren, k=0;
        JInternalFrame f;
        JInternalFrame[] aframe = desktop.getAllFrames();
        Nren = (int)aframe.length / 2;
        if ( aframe.length % 2 == 1 ) Nren++; //Num d Ventanas impares
        ancho = (int)desktop.getWidth() / 2;
        alto  = (int)desktop.getHeight() / Nren;
        for(int r=0; r<Nren; r++)
          for(int c=0; (c < 2) && (k < aframe.length) ; c++)
          { f = aframe[k]; k++;
            try{ f.setIcon( false ); }
            catch( java.beans.PropertyVetoException e ) {};
            try{ f.setMaximum( false ); }
            catch( java.beans.PropertyVetoException e ) {}; 
            f.setSize( ancho, alto );
            if (c == 0 ) f.setLocation( 0, r * alto );   // Col izquierda
            else         f.setLocation( ancho, r * alto ); // Col derecha            
          }
      }
// --------------------------------------------------------------------------	
	public void VenOrgMenuMosaicoHorizontal()
      { int ancho;
        JInternalFrame f;
        JInternalFrame[] aframe = desktop.getAllFrames();
        ancho = desktop.getWidth() / aframe.length;
        for(int k=0; k < aframe.length; k++ )
        { f = aframe[k];
          try{ f.setIcon( false ); }
          catch( java.beans.PropertyVetoException e ) {};
          try{ f.setMaximum( false ); }
          catch( java.beans.PropertyVetoException e ) {}; 
          f.setSize( ancho, desktop.getHeight() ); f.setLocation( k * ancho, 0);
        }
      }
// --------------------------------------------------------------------------	
	public void VenOrgMenuMosaicoVertical()
      { int alto;
        JInternalFrame f;
        JInternalFrame[] aframe = desktop.getAllFrames();
        alto = desktop.getHeight() / aframe.length;
        for(int k=0; k < aframe.length; k++ )
        { f = aframe[k];
          try{ f.setIcon( false ); }
          catch( java.beans.PropertyVetoException e ) {};
          try{ f.setMaximum( false ); }
          catch( java.beans.PropertyVetoException e ) {}; 
          f.setSize( desktop.getWidth() , alto ); f.setLocation( 0, k * alto );
        }
      }
// --------------------------------------------------------------------------	
	public void VenOrgMenuMinimizar()
      { JInternalFrame f;
        JInternalFrame[] aframe = desktop.getAllFrames();
        for(int k=0; k < aframe.length; k++ )
        { f = aframe[k];
          try{ f.setIcon( true ); }
          catch( java.beans.PropertyVetoException e ) {};
        }
      }
// --------------------------------------------------------------------------	
	public void VenOrgMenuRestaurar()
      { JInternalFrame f;
        JInternalFrame[] aframe = desktop.getAllFrames();
        for(int k=0; k < aframe.length; k++ )
        { f = aframe[k];
          try{ f.setIcon( false ); }
          catch( java.beans.PropertyVetoException e ) {};
          try{ f.setMaximum( false ); }
          catch( java.beans.PropertyVetoException e ) {};         
        }
      }
// --------------------------------------------------------------------------	
	public void VenOrgMenuMaximizar()
      { JInternalFrame f;
        JInternalFrame[] aframe = desktop.getAllFrames();
        for(int k=0; k < aframe.length; k++ )
        { f = aframe[k];
          try{ f.setMaximum( true ); }
          catch( java.beans.PropertyVetoException e ) {};
        }
      }
