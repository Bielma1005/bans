	/** 	*Crea el progres Monitor 	*/

	private void createMonitor(String algoritmo, boolean determinate, int maxValue)
	{
		pMonitor=new Progress(this,algoritmo,determinate,maxValue,icon);

		// Agregada por AAT
//		 pMonitor.parent = this;

		pMonitor.addInternalFrameListener( new internalFrameListener() );
		pMonitor.addMouseListener( new mouseListener() );
		pMonitor.show();
		desktop.add(pMonitor);

		new Thread(pMonitor).start();
		//pMonitor.setMillisToDecideToPopup(500);
		pMonitor.setProgress(0);
	}
// ------------------------------------------------------------------------
  public boolean HayVentanasAbiertas()
  {
    JInternalFrame[] frames=desktop.getAllFrames();
    if ( frames.length > 0 ) return( true  );
    else                     return( false );
  }
// ------------------------------------------------------------------------
	//este metodo carga los datos desde un archivo de texto
  private void cargarDatos()
  {
     if ( HayVentanasAbiertas() )
     { JOptionPane.showMessageDialog(this,
         "Debe cerrar todas las ventanas antes de cargar nuevos datos",
         "Ventanas", JOptionPane.INFORMATION_MESSAGE);
     }
     else 
     {
	  setInitD();
	  ExampleFileFilter xmlFilter = new ExampleFileFilter("txt", "Text Files (Data Base)");
	  chooser.setFileFilter(xmlFilter);
	  chooser.setDialogTitle("Cargar datos desde una archivo de texto");
	  chooser.setDialogType(JFileChooser.OPEN_DIALOG);
	  int returnVal = chooser.showOpenDialog(this);
	  if(returnVal == JFileChooser.APPROVE_OPTION) 
        {		
          String directory = chooser.getSelectedFile().getPath();
          bPE.numVariables = 6;

          setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));
          try
          { 
           bPE.inicio=null;
            bPE.inArco=null;
            Archivo arch=new Archivo();				
            bPE.inicio = arch.leer(directory);
            bPE.casos = arch.casos;				
            bPE.varDep=arch.varDep;
            bPE.varDep2=arch.varDep;
            bPE.numVariables=arch.numVariables;
            getValues();
            Red red =new Red();
            red.inicio=bPE.inicio;
            red.inArco=null;

//            agregarRed(red, directory);
            agregarRed(red, directory, true); //Sin botones


            bPE.baseName=directory;
          } catch(Exception e){};
          
          bPE.Casos = bPE.casos.size();
          setCursor(Cursor.getPredefinedCursor(Cursor.DEFAULT_CURSOR));		
          probability();
        }
    }
  }
