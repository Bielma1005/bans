	//para avisarle al rame que ponga un nodo
	private void agregarNodo()
	{
		RedFrame redF=(RedFrame)desktop.getSelectedFrame();
		if(redF!=null)
		{			
			redF.redPanel.newNode=true;
		}
		else
		{			
			//enviar un mensaje en el que le diga que debe agregar un red nueva antes
			JOptionPane.showMessageDialog(this,"There is not any selected network","Network",JOptionPane.INFORMATION_MESSAGE);
		}
	}
	//para avisarle al frame que ponga un arco
	private void agregarArco()
	{
		RedFrame redF=(RedFrame)desktop.getSelectedFrame();
		if(redF!=null)
		{
			if(redF.redPanel.numVariables>1)
				redF.redPanel.newArco=true;
		}
		else
		{			
			//enviar un mensaje en el que le diga que debe agregar un red nueva antes
			JOptionPane.showMessageDialog(this,"No ha seleccionado una red. Seleccione la ventana que contiene la red bayesiana que sea evaluar","Error en la selección",JOptionPane.INFORMATION_MESSAGE);
		}
	}

	//este metodo se llama cuando se presiona el boton de borrar, y lo que
	//hace es verificar si algon elemento de la red esta seleccionado, si asi es,
	//trata de borrarlo
	private void borrar()
	{
		RedFrame redF=(RedFrame)desktop.getSelectedFrame();
		if(redF!=null)
		{
			if(redF.redPanel.selectedN!=null)
			{
				//quiere decir que esta seleccionado un nodo
				//hay que remover tods los arcos en los que participaba este nodo
				Arco temp=redF.redPanel.red.inArco;
				if(temp!=null)
				{
					do
					{
						if(temp.from.name.equals(redF.redPanel.selectedN.name) || temp.to.name.equals(redF.redPanel.selectedN.name))
						{
							redF.redPanel.red.inArco=util.remove(temp,redF.redPanel.red.inArco);
						}
						temp=temp.sig;
					}
					while (temp!=null);
				}								
				redF.redPanel.red.inicio=util.removeNode(redF.redPanel.selectedN,redF.redPanel.red.inicio);				
				redF.redPanel.selectedN=null;
				redF.redPanel.repaint();
			}
			if(redF.redPanel.selectedA!=null)
			{
				//quiere decir que esta seleccionado un arco				
				redF.redPanel.red.inArco=util.remove(redF.redPanel.selectedA,redF.redPanel.red.inArco);
				redF.redPanel.selectedA=null;
				redF.redPanel.repaint();
			}

		}
		else
		{			
			//enviar un mensaje en el que le diga que debe agregar un red nueva antes
			JOptionPane.showMessageDialog(this,"No ha seleccionado una red. Seleccione la ventana que contiene la red bayesiana que sea evaluar","Error en la selección",JOptionPane.INFORMATION_MESSAGE);
		}
	}

	private void probability()
	{
		
		if((desktop.getSelectedFrame())!=null)//
		{
                    RedFrame redF=(RedFrame)desktop.getSelectedFrame();
			if(bPE.casos!=null)
			{
				ProbInf pro=new ProbInf();
				pro.casos=bPE.casos;
				redF.redPanel.red=pro.probabilityTables(redF.redPanel.red);
			}
		}
		else
		{
			//enviar un mensaje en el que le diga que debe agregar un red nueva antes
			JOptionPane.showMessageDialog(this,"No ha seleccionado una red. Seleccione la ventana que contiene la red bayesiana que sea evaluar","Error en la selección",JOptionPane.INFORMATION_MESSAGE);
		}
	}
//-----------------------------------------------------------------------------------------
	private void probabilityDistribution()
	{	
           
		if((desktop.getSelectedFrame())!=null && (desktop.getSelectedFrame()).getClass().getName().equals("bansy21.Gui.RedFrame") && bPE.casos!=null)//
		{	
                    RedFrame redF=(RedFrame)desktop.getSelectedFrame();		
			jp=new JointProbability(redF.redPanel.red,bPE.casos);			
			//jp.generate();
			jp.generateFromRed();

			ShowerTable st=new ShowerTable(this,jp.comb,jp.table,redF.redPanel.red);

			// Agregada por AAT
			desktop.add(st);
			try {	
				st.setMaximum(true); 
			}catch(Exception e){};
			try {
				st.setSelected(true);
			} catch (java.beans.PropertyVetoException e) {}
		}
		else
		{
			if (bPE.inicio!=null && bPE.casos!=null)
			{
                             RedFrame redF=(RedFrame)desktop.getSelectedFrame();		
				Red  red= new Red();
				red.inicio=bPE.inicio;
				jp=new JointProbability(red,bPE.casos);				
				jp.generate();
				ShowerTable st=new ShowerTable(this,jp.comb,jp.table,redF.redPanel.red);

				// Agregada por AAT
				desktop.add(st);
				try {	
					st.setMaximum(true); 
				}catch(Exception e){};
				try {
					st.setSelected(true);
				} catch (java.beans.PropertyVetoException e) {}
			}
			else
			{
				//enviar un mensaje en el que le diga que debe agregar un red nueva antes
				JOptionPane.showMessageDialog(this,"No ha seleccionado una red. Seleccione la ventana que contiene la red bayesiana que sea evaluar","Error en la selección",JOptionPane.INFORMATION_MESSAGE);
			}
		}
// Agregada por AAT
		createMenuVentana();

	}
//-----------------------------------------------------------------------------------------
	/**
	* Método de inferencia general
	*/
	private void inferenciaGeneral()
	{
		/*
		
		si no se ha calculado la tabla de probabilidades a partir de la red bayesiana
		entonces calcularla

		ya que se tiene la tabla, mostrar una ventana con el nodo consulta, y en un comboBox los valores 
		que puede tomar el nodo, para que el usuario seleccione uno, lo mismo se hace para los nodos evidencia
		(un combo para cada uno)

		ya que se selecciono, entonces echar a andar el metodo para calcular la probabildiad, que prodria ser 
		en la misma ventana, de esta forma el usuario pórdria cambiar los valores y recalcular
		si quiere agregar mas nodos de evidencia, entonces tendra que cerrar la ventana	

		*/
		
		
		if((desktop.getSelectedFrame())!=null && (desktop.getSelectedFrame()).getClass().getName().equals("bansy21.Gui.RedFrame") && jp!=null)//
		{
			RedFrame redF=(RedFrame)desktop.getSelectedFrame();
         
         /*
         createMonitor("Inferencia",true,jp.comb.length);
			InferenciaGeneral infG=new InferenciaGeneral();
			infG.jp=jp;
			jp.pMonitor=pMonitor;
			infG.pMonitor=pMonitor;
			infG.red=redF.redPanel.red;
			infG.start();
			*/
        
         jframeInference jfr= new bansy21.Gui.jframeInference(redF.redPanel.red);
         jfr.jp=jp;
         
         jfr.show();
         
         desktop.add(jfr);
         createMenuVentana();
         desktop.setSelectedFrame(jfr);
		}
		else
		{
			//enviar un mensaje en el que le diga que debe agregar un red nueva antes
			JOptionPane.showMessageDialog(this,"No ha seleccionado una red. Seleccione la ventana que contiene la red bayesiana que sea evaluar","Error en la selección",JOptionPane.INFORMATION_MESSAGE);
		}


	}

	/**
	*Calcula la medida Bayesiana para la red
	*/
	private void bayesianMeasure()
	{
		
		if((desktop.getSelectedFrame())!=null && (desktop.getSelectedFrame()).getClass().getName().equals("bansy21.Gui.RedFrame"))//
		{
                    RedFrame redF=(RedFrame)desktop.getSelectedFrame();
			if(bPE.casos!=null && redF.redPanel.red.inicio.parents!=null)
			{
				BMeasure bm=new BMeasure();
				bm.red=redF.redPanel.red;
				bm.casos=bPE.casos;
				createMonitor("Métrica Bayesiana", true, bPE.casos.size()+bPE.numVariables);
				bm.pMonitor=pMonitor;
				bm.start();
                                this.setSelectedFrame(pMonitor);
                                
			}
		}
		else
		{
			//enviar un mensaje en el que le diga que debe agregar un red nueva antes
			JOptionPane.showMessageDialog(this,"No ha seleccionado una red. Seleccione la ventana que contiene la red bayesiana que sea evaluar","Error en la selección",JOptionPane.INFORMATION_MESSAGE);
		}
                createMenuVentana();
	}
	
	/**
	*Calcula el MDL de laforma en que lo calcula Remco
	*/
	private void MDLMatric()
	{                
		if((desktop.getSelectedFrame())!=null && (desktop.getSelectedFrame()).getClass().getName().equals("bansy21.Gui.RedFrame"))//
		{
                    RedFrame redF=(RedFrame)desktop.getSelectedFrame();
			if(bPE.casos!=null && redF.redPanel.red.inicio.parents!=null)
			{
				createMonitor("MDL (Remco)", true, bPE.casos.size()+bPE.numVariables);
				MDL mdl=new MDL();
				mdl.red=redF.redPanel.red;
				mdl.casos=bPE.casos;
				mdl.pMonitor=pMonitor;
				mdl.start();
                                this.setSelectedFrame(pMonitor);
				//System.out.println("Resultado:  "+mdl.getMDL(redF.redPanel.red,casos));				
			}
		}
		else
		{
			//enviar un mensaje en el que le diga que debe agregar un red nueva antes     3025.8915996018195
			JOptionPane.showMessageDialog(this,"No ha seleccionado una red. Seleccione la ventana que contiene la red bayesiana que sea evaluar","Error en la selección",JOptionPane.INFORMATION_MESSAGE);
		}
                 createMenuVentana();
	}

