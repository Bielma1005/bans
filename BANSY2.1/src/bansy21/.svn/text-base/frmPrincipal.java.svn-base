    // esta clase es la encargada de recivir los eventos del menu y de la barra de hts
	public class EventHelper implements ActionListener
	{
        public void actionPerformed(java.awt.event.ActionEvent event)
        {
           Object objeto=event.getSource();
           for ( int i=0; i < jmVentana.getItemCount(); i++ )
             if( objeto == jmVentana.getItem(i) )
               try{ 
                 ((JMenuItemExtended)jmVentana.getItem(i)).InternalFrame.setSelected(true); 
                 break;
               }catch(Exception e){ System.out.println("Error Cast, Menu ventana"); };
               
     // --------------------------------------

        }
	}       
       
        private void guardarProyecto()
        {
            setInitD();	
           // ExampleFileFilter xmlFilter = new ExampleFileFilter("BNproy", "Proyecto Bansy 2");			
            //chooser.setFileFilter(xmlFilter);
            chooser.setDialogType(JFileChooser.SAVE_DIALOG);
            chooser.setDialogTitle("Guarder los arcos de la red");
            int returnVal = chooser.showSaveDialog(this);
            addPanelsAndMonitorsProperties();
            if(returnVal == JFileChooser.APPROVE_OPTION)
            {	
                String directory = chooser.getSelectedFile().getPath();		
                (new Archivo2()).guardarProyecto(bPE,directory);
            }
        }
        
        private void addPanelsAndMonitorsProperties()
        {
           Object[] frames=(Object[])desktop.getAllFrames();
           bPE.netsOfPanels=new Red[frames.length];
           bPE.namesPanels=new String[frames.length];
           for (int i=0;i<frames.length;i++)
           {
               String clase=frames[i].getClass().toString();
              System.out.print(clase);
               
           }
        }
        
