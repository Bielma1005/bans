	//*****************   agrega internal frames******************
		//agrega un Internal frame en el que se digbuijara la red
	public void agregarRed(Node inic, Arco inicA,String nombre)
	{
//		RedFrame redFrame=new RedFrame(nombre);
		RedFrame redFrame=new RedFrame(nombre, this);
		Red red=new Red();

		red.inicio=inic;
		red.inArco=inicA;
		red.varDep=bPE.varDep;
		redFrame.redPanel.red=red;
		redFrame.redPanel.numVariables=bPE.numVariables;
		redFrame.redPanel.parent=this;
		redFrame.addInternalFrameListener(new internalFrameListener());
		redFrame.setIcon(icon);
		redFrame.addMouseListener(new mouseListener());
		redFrame.show();
		desktop.add(redFrame);
		try
		{
			redFrame.setMaximum(true);
		}catch(Exception e){};
		try 
		{
			redFrame.setSelected(true);
		} catch (java.beans.PropertyVetoException e) {}
		createMenuVentana();
	}
