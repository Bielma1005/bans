	/********************ALGORITMOS*************************/
	private void bayes()
	{	
		if (bPE.inicio!=null)
		{		
			DiaParametros alf=new DiaParametros(this);
		//	alf.setLocation(200,200);
			alf.l1.setText("Alfa:(%)");
			alf.l2.setEnabled(false);
			alf.t2.setEnabled(false);
			alf.l3.setEnabled(false);
			alf.t3.setEnabled(false);
			alf.show();
			
			if(!alf.cancel)
			{
				setCursor(Cursor.getPredefinedCursor(Cursor.WAIT_CURSOR));
				bPE.alfaG=(new Double(alf.t1.getText())).doubleValue()/100.00;
				bPE.alfa=bPE.alfaG;
				Bayes b=new Bayes();		
				b.casos=bPE.casos.size();
				b.alfa=bPE.alfa;
				b.pro.casos=bPE.casos;		 
				RedFrame redF=(RedFrame)desktop.getSelectedFrame();
				Calendar date1=Calendar.getInstance();
  
				createMonitor("Bayes2",true,bPE.numVariables);
				b.pMonitor=pMonitor;
				b.inicio=bPE.inicio;
				b.parent=this;
				b.baseName=bPE.baseName;
						
					
				if(redF!=null)
				{	
					if(redF.redPanel.selectedN!=null)
					{
						b.varDepName=redF.redPanel.selectedN.name;
						b.pro.varDep=redF.redPanel.selectedN;						
					}
					else
					{
						b.varDepName=bPE.varDep.name;
						b.pro.varDep=bPE.varDep;
					}				
					b.start();							
				}
				else if(bPE.inicio != null)
				{
					b.varDepName=bPE.varDep.name;
					b.pro.varDep=bPE.varDep;
					b.start();				
				}
				Calendar date2=Calendar.getInstance();													
				System.out.println(""+util.tiempoEmpleado(date1,date2));
				setCursor(Cursor.getPredefinedCursor(Cursor.DEFAULT_CURSOR));
			}
		}
		else
		{
			JOptionPane.showMessageDialog(this,"Necesita cargar los datos","Datos",JOptionPane.INFORMATION_MESSAGE);
		}
	}
