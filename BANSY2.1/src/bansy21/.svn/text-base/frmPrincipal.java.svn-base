		}
                 createMenuVentana();
	}

	

	/**
	*REaliza la clasificacion de ejemplos leidos desde un archivo de ejemplos
	*para una red bayesiana generada con algun algoritmo de la familia de los bayes
	*/
	private void generalClasificacion()
	{
		RedFrame redF=(RedFrame)desktop.getSelectedFrame();
		if(redF!=null)//
		{
			setInitD();

			//leer ejemplos para su clasificacion
			ExampleFileFilter xmlFilter = new ExampleFileFilter("txt", "Text Files");
			chooser.setFileFilter(xmlFilter);
			chooser.setDialogType(JFileChooser.OPEN_DIALOG);
	    int returnVal = chooser.showOpenDialog(this);
	    if(returnVal == JFileChooser.APPROVE_OPTION) 
			{
				String directory = chooser.getSelectedFile().getPath();
				ClasificacionGeneral naiC=new ClasificacionGeneral(redF.redPanel.red);
				Vector tempC=null;
				try
				{
					tempC=(new Archivo2()).leerEjemplos(directory);					
				}catch(Exception e){System.out.println("error clasificacion naive");}
				if (tempC.size()>0)
				{
					System.out.println("la probaba "+naiC.makeClasification(tempC));
				}				
			}
		}
		else
		{
			//enviar un mensaje en el que le diga que debe agregar un red nueva antes     3025.8915996018195
			JOptionPane.showMessageDialog(this,"No ha seleccionado una red","No ha seleccionado una red",JOptionPane.INFORMATION_MESSAGE);
		}
	}
	/**
	*REaliza la clasificacion de ejemplos leidos desde un archivo de ejemplos
	*para una red bayesiana generada con algun algoritmo de la familia de los bayes
	*/
	private void naiveClasification()
	{
		RedFrame redF=(RedFrame)desktop.getSelectedFrame();
		if(redF!=null)//
		{
			setInitD();
			ExampleFileFilter xmlFilter = new ExampleFileFilter("txt", "Text Files");
			chooser.setFileFilter(xmlFilter);
			chooser.setDialogType(JFileChooser.OPEN_DIALOG);
	    int returnVal = chooser.showOpenDialog(this);
	    if(returnVal == JFileChooser.APPROVE_OPTION) 
			{
				String directory = chooser.getSelectedFile().getPath();		    
				ClasificacionNaive naiC=new ClasificacionNaive(redF.redPanel.red);
				Vector tempC=null;
				try
				{
					tempC=(new Archivo2()).leerEjemplos(directory);					
				}catch(Exception e){System.out.println("error clasificacion naive");}
				if (tempC.size()>0)
				{
					System.out.println("la probaba "+naiC.makeClasification(tempC));
				}				
			}
		}
		else
		{
			//enviar un mensaje en el que le diga que debe agregar un red nueva antes     3025.8915996018195
			//System.out.println("No hay ninguna red seleccionada");
			JOptionPane.showMessageDialog(this,"No ha seleccionado una red","No ha seleccionado una red",JOptionPane.INFORMATION_MESSAGE);
		}
	}
	

	private void crossVal()
	{
		DCrossValidation dc=new DCrossValidation(this,"Cross-Validation",true);
		if (dc.aceptar)
		{
			CrossValidation c1=new CrossValidation();			
			//obatener los parametros de bayesN
			double talfa=0;
			double talfaG=0;
			int tprofundidad=0;
			double tminPorcGan=0;

			if (dc.bayesn.isSelected())
			{
				talfaG=(new Double(dc.tAlfa.getText())).doubleValue()/100.00;
				talfa=bPE.alfaG;
				tprofundidad=(new Integer(dc.tProfundidad.getText())).intValue();
				tminPorcGan=(new Double(dc.tIMin.getText())).doubleValue();
			}
			String directory=dc.textFile.getText();
			String baseN=dc.baseName;
			int fold=(new Integer(dc.textFolds.getText())).intValue();
			Archivo tempC=null;
			
			c1.naive=dc.naive.isSelected();
			c1.bayesn=dc.bayesn.isSelected();
			c1.bayes9=dc.bayes9.isSelected();
			c1.guardar=dc.guardar.isSelected();
			if (c1.naive || c1.bayesn || c1.bayes9)
			{			
				try
				{
					tempC=new Archivo();
					bPE.inicio=tempC.leer(directory);
					bPE.casos=tempC.casos;
					bPE.numVariables=tempC.numVariables;
					bPE.varDep=tempC.varDep;
					getValues();
	
					c1.cas=bPE.casos.size();
					c1.alfaG=talfaG;
					c1.alfa=talfa;
					c1.minPorcGan=(double)tminPorcGan;
					c1.profundidad=tprofundidad;
					c1.numVariables=bPE.numVariables;
					c1.baseName=baseN;
					Red red=new Red();
					red.inicio=bPE.inicio;
					red.varDep=bPE.varDep;
					c1.red=red;
					c1.parent=this;
					c1.casos=bPE.casos;				
					createMonitor("Cross-Validation",true,fold);
					c1.pMonitor=pMonitor;
					c1.fold=fold;
					c1.start();
				}
				catch(Exception e){};
			}
			else
			{
				//send a message
				JOptionPane.showMessageDialog(this,"You did not choose any algorithm","Cross-Validation",JOptionPane.INFORMATION_MESSAGE);
			}			
		}
	}
	
	public void holdOut()
	{
		
		DCrossValidation dc=new DCrossValidation(this,"Cross-Validation",false);
		if (dc.aceptar)
		{
			HoldOut c1=new HoldOut();			
			//obatener los parametros de bayesN
			double talfa=0;
			double talfaG=0;
			int tprofundidad=0;
			double tminPorcGan=0;

			if (dc.bayesn.isSelected())
			{
				talfaG=(new Double(dc.tAlfa.getText())).doubleValue()/100.00;
				talfa=bPE.alfaG;
				tprofundidad=(new Integer(dc.tProfundidad.getText())).intValue();
				tminPorcGan=(new Double(dc.tIMin.getText())).doubleValue();
			}

			String directory=dc.textFile.getText();
			String baseN=dc.baseName;
			double hold=(new Double(dc.textFolds.getText())).doubleValue();
			Archivo tempC=null;
			
			c1.naive=dc.naive.isSelected();
			c1.bayesn=dc.bayesn.isSelected();
			c1.bayes9=dc.bayes9.isSelected();
			c1.guardar=dc.guardar.isSelected();
			
			if (c1.naive || c1.bayesn || c1.bayes9)
			{			
				try
				{
					tempC=new Archivo();
					bPE.inicio=tempC.leer(directory);
					bPE.casos=tempC.casos;
					bPE.numVariables=tempC.numVariables;
					bPE.varDep=tempC.varDep;
					getValues();
	
					c1.cas=bPE.casos.size();
					c1.alfaG=talfaG;
					c1.alfa=talfa;
					c1.minPorcGan=(double)tminPorcGan;
					c1.profundidad=tprofundidad;
					c1.numVariables=bPE.numVariables;
					c1.baseName=baseN;
					Red red=new Red();
					red.inicio=bPE.inicio;
					red.varDep=bPE.varDep;
					c1.red=red;
					c1.casos=bPE.casos;
					createMonitor("Hold-Out",true,10);
					c1.parent=this;
					c1.pMonitor=pMonitor;
					c1.hold=hold;
					c1.start();
				}
				catch(Exception e){};
			}
			else
			{
				//send a message
				JOptionPane.showMessageDialog(this,"You did not choose any algorithm","Cross-Validation",JOptionPane.INFORMATION_MESSAGE);
			}			
		}
	}
	
	/**
	*REaliza automaticamante la clasificacion de ejemplos leidos desde un archivo de ejemplos
	*usando una red naive y la inferencia naive
	*/
	private void naiveAndBayesClasification()
	{
		DiaParametros alf=new DiaParametros(this);
		alf.setLocation(200,200);
		alf.show();
		alf.noBayesN=false;			
		if(!alf.cancel)
		{
			
			bPE.alfaG=(new Double(alf.t1.getText())).doubleValue()/100.00;
			bPE.alfa=bPE.alfaG;
			bPE.profundidad=(new Integer(alf.t2.getText())).intValue();
			bPE.minPorcGan=(new Double(alf.t3.getText())).doubleValue();		


			setInitD();
			ExampleFileFilter xmlFilter = new ExampleFileFilter("txt", "Text Files");
			chooser.setFileFilter(xmlFilter);
			chooser.setDialogType(JFileChooser.OPEN_DIALOG);
	    int returnVal = chooser.showOpenDialog(this);
	    if(returnVal == JFileChooser.APPROVE_OPTION) 
			{
				String directory = chooser.getSelectedFile().getPath();
				Archivo tempC=null;
				try
				{
					tempC=new Archivo();
					bPE.inicio=tempC.leer(directory);
					bPE.casos=tempC.casos;
					bPE.numVariables=tempC.numVariables;
					bPE.varDep=tempC.varDep;
					getValues();
					
					Clasificacion c1=new Clasificacion();
					createMonitor("Clasificación",true,100);
					c1.pMonitor=pMonitor;
					c1.cas=bPE.casos.size();
					c1.casos=bPE.casos;
					c1.alfaG=bPE.alfaG;
					c1.alfa=bPE.alfa;
					c1.minPorcGan=(double)bPE.minPorcGan;
					c1.profundidad=bPE.profundidad;
					c1.numVariables=bPE.numVariables;
					c1.inicio=bPE.inicio;
					c1.varDep=bPE.varDep;
					c1.parent=this;
					c1.por=0.8;
					c1.baseName= chooser.getSelectedFile().getName();
					
					c1.start();;
				}catch(Exception e){e.printStackTrace(System.out);}				
					//System.out.println("la probaba "+naiC.makeClasification(tempC));								
			}
		}

			
	/*	}
		else
		{
			//enviar un mensaje en el que le diga que debe agregar un red nueva antes     3025.8915996018195
			System.out.println("No hay ninguna red seleccionada");
		}*/
	}

