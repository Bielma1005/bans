					agregarRed(bPE.inicio,(new Archivo()).leerArcosFromElviraFormat(directory,bPE.inicio),directory);
				}
				catch(Exception e){System.out.println("Error al cargar el archivo "+e.getMessage());};
			}
		}
		else
		{
			JOptionPane.showMessageDialog(this,"You need to load data firts","Data needed",JOptionPane.INFORMATION_MESSAGE);
		}
	}

