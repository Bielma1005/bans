//----------------------------------------------------------------------------
	/**
	* Obtiene la red NaiveBayes
	*/
	private void naiveBayes()
	{
        if(bPE.inicio!=null)
        {
          Red red;
          NaiveBayes nai=new NaiveBayes();
          RedFrame redF=(RedFrame)desktop.getSelectedFrame();
          if(redF!=null)
            if(redF.redPanel.selectedN!=null) nai.varDep=redF.redPanel.selectedN;
            else nai.varDep=bPE.varDep;
          else nai.varDep=bPE.varDep;
          nai.pro.casos=bPE.casos;
          red=nai.getRedNaive(bPE.inicio);
          agregarRed(red,bPE.baseName+"_NaiveBayes");
        }
        else
          JOptionPane.showMessageDialog(this,"Necesita cargar los datos","Datos",JOptionPane.INFORMATION_MESSAGE);
	}
