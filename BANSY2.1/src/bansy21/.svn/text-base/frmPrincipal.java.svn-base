    public void createMenuVentana()
	{
           // if(jmVentana!= null)
           //   jmenuPrincipal.remove(jmVentana);
            
            jmVentana.removeAll();
            jmVentana.add(jmMenuOrgVen);
            jmVentana.add(new JSeparator());

            JInternalFrame[] frames=desktop.getAllFrames();
            ventanas=new JMenuItemExtended[frames.length];
//		for (int i=0;i<frames.length;i++)
            for ( int i=frames.length-1; i >= 0; i-- )
		{
//			ventanas[i]=new JMenuItemExtended(((RedFrame)frames[i]).redPanel.red.name+i);  
//			ventanas[i]=new JMenuItemExtended( frames[i].getTitle() );

			ventanas[i]=new JMenuItemExtended( ((JInternalFrame) frames[i]).getTitle() );
			try{
				ventanas[i].InternalFrame = frames[i];
				ventanas[i].red=((RedFrame)frames[i]);

			} catch( Exception e ) {System.out.println("CreateMenuVentana: esta ventana no es red"); }
			System.out.println("CreateMenuVentana: Agrega ActionListener");
			ventanas[i].addActionListener(eventListener);
			jmVentana.add(ventanas[i]);
		}
		//jmenuPrincipal.add(jmVentana);
            //setJMenuBar( b_menu );
	      // pack();
	}
// -----------------------------------------------------------------------------------------------
  
    public void CierraVentanas()
  {
    JInternalFrame[] frames=desktop.getAllFrames();
    for ( int i=frames.length-1; i >= 0; i-- )
    {
	try{
	  frames[i].setClosed( true );
      } catch( Exception e ) {}
    }
    createMenuVentana();
  }
    
    
    
