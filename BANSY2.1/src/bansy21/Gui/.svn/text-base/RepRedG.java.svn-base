    public  int Renglon;        
    public  int RenglonEspacio;        
    public  int AnchoTablaProb;
    public  int AnchoRep;
    private String texto;
    public  Red red;    
    public  JScrollPane jScrollPane1;
    public  JButton BtnGuardarComo;
    public  JPanel jPanel1;
    private JFileChooser jFileChooser1;
